# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=folio_db

# Storage Provider Configuration
# Choose between 'filesystem' (default local disk) or 's3' (AWS S3, MinIO, Cloudflare R2, LocalStack)
FOLIO_STORAGE_BACKEND=filesystem
FOLIO_STORAGE_ROOT=storage

# S3 Compatible Object Storage (Active when FOLIO_STORAGE_BACKEND=s3)
FOLIO_S3_BUCKET=folio-storage
FOLIO_S3_REGION_NAME=us-east-1
# FOLIO_S3_ENDPOINT_URL=http://localhost:9000  # Uncomment for MinIO, Cloudflare R2, or LocalStack
# FOLIO_S3_ACCESS_KEY_ID=minioadmin
# FOLIO_S3_SECRET_ACCESS_KEY=minioadmin
# FOLIO_S3_PREFIX=notes/                      # Optional key prefix namespace
