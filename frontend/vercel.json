{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://folio-api-uzrj.onrender.com/assets/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://folio-api-uzrj.onrender.com/api/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}