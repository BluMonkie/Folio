{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "$VITE_API_BASE_URL/assets/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "$VITE_API_BASE_URL/api/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
